generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum CourseStatus {
  ACTIVE
  UPCOMING
  COMPLETED
}

enum SessionStatus {
  AVAILABLE
  UPCOMING
  LOCKED
}

enum LessonStatus {
  DONE
  NEXT
  PLANNED
}

enum LessonType {
  PRIVATE
  GROUP
  THEORY
}

enum SlideKind {
  COVER
  LESSON
  VISUAL
  OUTRO
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @db.VarChar(40)
  lastName     String   @db.VarChar(40)
  displayName  String   @db.VarChar(81)
  email        String?  @unique @db.VarChar(255)
  passwordHash String
  role         Role     @default(STUDENT)
  studentCode  String?  @unique @db.VarChar(32)
  level        String?  @db.VarChar(64)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  enrollments     Enrollment[]
  achievements    UserAchievement[]
  sessionProgress SessionProgress[]

  @@unique([firstName, lastName])
  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?   @db.VarChar(512)
  ipAddress String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(64)
  title            String       @db.VarChar(200)
  subtitle         String       @db.VarChar(300)
  instrument       String       @db.VarChar(64)
  teacher          String       @db.VarChar(120)
  teacherShort     String       @db.VarChar(80)
  day              String       @db.VarChar(32)
  time             String       @db.VarChar(64)
  timeShort        String       @db.VarChar(32)
  duration         String       @db.VarChar(32)
  room             String       @db.VarChar(120)
  level            String       @db.VarChar(64)
  focus            String       @db.VarChar(300)
  sessionsTotal    Int
  weeklyHours      Int          @default(2)
  status           CourseStatus @default(ACTIVE)
  certificateReady Boolean      @default(false)
  accessNote       String?      @db.VarChar(500)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions     CourseSession[]
  lessons      ScheduleLesson[]
  enrollments  Enrollment[]
  practiceTips PracticeTip[]

  @@index([status, isActive])
  @@index([sortOrder])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  joinedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model CourseSession {
  id            String        @id @default(uuid()) @db.Uuid
  courseId      String        @db.Uuid
  number        Int
  title         String        @default("") @db.VarChar(200)
  summary       String        @db.VarChar(1000)
  topics        String[]
  status        SessionStatus @default(LOCKED)
  durationLabel String        @db.VarChar(32)
  dateLabel     String        @db.VarChar(64)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  course   Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slides   Slide[]
  progress SessionProgress[]
  lessons  ScheduleLesson[]

  @@unique([courseId, number])
  @@index([status])
}

model Slide {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  sourceId  String    @db.VarChar(64)
  sortOrder Int
  chapter   String    @db.VarChar(16)
  title     String    @db.VarChar(400)
  goal      String    @default("") @db.VarChar(1000)
  body      String
  bullets   String[]
  terms     Json
  mistakes  String[]
  imageHint String?   @db.VarChar(500)
  imageId   String?   @db.VarChar(512)
  funFact   String?   @db.VarChar(1000)
  kind      SlideKind @default(LESSON)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceId])
  @@index([sessionId, sortOrder])
}

model ScheduleLesson {
  id         String       @id @default(uuid()) @db.Uuid
  courseId   String       @db.Uuid
  sessionId  String?      @db.Uuid
  title      String       @db.VarChar(300)
  teacher    String       @db.VarChar(120)
  day        String       @db.VarChar(32)
  dateLabel  String       @db.VarChar(64)
  time       String       @db.VarChar(64)
  room       String       @db.VarChar(120)
  type       LessonType   @default(THEORY)
  duration   String       @db.VarChar(32)
  note       String?      @db.VarChar(500)
  status     LessonStatus @default(PLANNED)
  sortOrder  Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([courseId, sortOrder])
}

model Achievement {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  title       String @db.VarChar(200)
  description String @db.VarChar(500)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model PracticeTip {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  text      String @db.VarChar(500)
  sortOrder Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

model SessionProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  sessionId      String    @db.Uuid
  lastSlideIndex Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}
