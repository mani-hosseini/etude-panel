generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  ACTIVE
  UPCOMING
  COMPLETED
}

enum SessionStatus {
  AVAILABLE
  UPCOMING
  LOCKED
}

enum LessonStatus {
  DONE
  NEXT
  PLANNED
}

enum LessonType {
  PRIVATE
  GROUP
  THEORY
}

enum SlideKind {
  COVER
  LESSON
  VISUAL
  OUTRO
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @db.VarChar(40)
  lastName     String   @db.VarChar(40)
  displayName  String   @db.VarChar(81)
  email        String?  @unique @db.VarChar(255)
  passwordHash  String
  role          Role     @default(STUDENT)
  studentCode  String?  @unique @db.VarChar(32)
  level        String?  @db.VarChar(64)
  avatarUrl    String?  @db.VarChar(512)
  phone        String?  @db.VarChar(32)
  nationalId   String?  @unique @db.VarChar(16)
  address      String?  @db.VarChar(500)
  title        String?  @db.VarChar(120)
  instrument   String?  @db.VarChar(64)
  room         String?  @db.VarChar(120)
  bio          String?  @db.VarChar(1000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  enrollments        Enrollment[]
  achievements       UserAchievement[]
  sessionProgress    SessionProgress[]
  examSubmissions    ExamSubmission[]
  examGrades         ExamGrade[]
  taughtCourses      Course[]                    @relation("CourseInstructor")
  givenAssignments   PracticeAssignment[]        @relation("AssignmentTeacher")
  assignmentTargets  PracticeAssignmentTarget[]
  attendanceMarks    AttendanceRecord[]          @relation("AttendanceStudent")
  markedAttendance   AttendanceRecord[]          @relation("AttendanceMarker")
  teacherNotes       TeacherNote[]               @relation("TeacherNoteAuthor")
  studentNotes       TeacherNote[]               @relation("TeacherNoteStudent")
  givenStars         StudentStarRating[]         @relation("StudentStarTeacher")
  receivedStars      StudentStarRating[]         @relation("StudentStarStudent")
  practiceLogs       PracticeLog[]
  supportTickets     SupportTicket[]

  @@unique([firstName, lastName])
  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?   @db.VarChar(512)
  ipAddress String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(64)
  title            String       @db.VarChar(200)
  subtitle         String       @db.VarChar(300)
  instrument       String       @db.VarChar(64)
  teacher          String       @db.VarChar(120)
  teacherShort     String       @db.VarChar(80)
  day              String       @db.VarChar(128)
  days             String[]     @default([])
  time             String       @db.VarChar(64)
  timeShort        String       @db.VarChar(32)
  duration         String       @db.VarChar(32)
  room             String       @db.VarChar(120)
  level            String       @db.VarChar(64)
  focus            String       @db.VarChar(300)
  sessionsTotal    Int
  weeklyHours      Int          @default(2)
  status           CourseStatus @default(ACTIVE)
  certificateReady Boolean      @default(false)
  accessNote       String?      @db.VarChar(500)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  teacherId        String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  instructor   User?            @relation("CourseInstructor", fields: [teacherId], references: [id], onDelete: SetNull)
  sessions     CourseSession[]
  lessons      ScheduleLesson[]
  enrollments  Enrollment[]
  practiceTips PracticeTip[]
  assignments  PracticeAssignment[]
  attendance   AttendanceRecord[]

  @@index([status, isActive])
  @@index([sortOrder])
  @@index([teacherId])
}

model Enrollment {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  courseId             String   @db.Uuid
  currentSessionNumber Int      @default(1)
  currentTerm          Int      @default(1)
  classDays            String[] @default([])
  sortOrder            Int      @default(0)
  joinedAt             DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, sortOrder])
}

model CourseSession {
  id            String        @id @default(uuid()) @db.Uuid
  courseId      String        @db.Uuid
  number        Int
  title         String        @default("") @db.VarChar(200)
  summary       String        @db.VarChar(1000)
  topics        String[]
  status        SessionStatus @default(LOCKED)
  durationLabel String        @db.VarChar(32)
  dateLabel     String        @db.VarChar(64)
  timeStart     String?       @db.VarChar(8)
  timeEnd       String?       @db.VarChar(8)
  homeworkTitle  String        @default("") @db.VarChar(200)
  homeworkSource String        @default("") @db.VarChar(200)
  homeworkNote   String        @default("") @db.VarChar(1000)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slides      Slide[]
  attachments SessionAttachment[]
  exercises   SessionExercise[]
  progress    SessionProgress[]
  lessons     ScheduleLesson[]
  assignments PracticeAssignment[]

  @@unique([courseId, number])
  @@index([status])
}

model SessionAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  path      String   @db.VarChar(512)
  filename  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(64)
  size      Int
  caption   String?  @db.VarChar(200)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sortOrder])
}

model SessionExercise {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  path      String   @db.VarChar(512)
  filename  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(64)
  size      Int
  caption   String?  @db.VarChar(200)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sortOrder])
}

model Slide {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  sourceId  String    @db.VarChar(64)
  sortOrder Int
  chapter   String    @db.VarChar(16)
  title     String    @db.VarChar(400)
  goal      String    @default("") @db.VarChar(1000)
  body      String
  bullets   String[]
  terms     Json
  mistakes  String[]
  imageHint String?   @db.VarChar(500)
  imageId   String?   @db.VarChar(512)
  funFact   String?   @db.VarChar(1000)
  kind      SlideKind @default(LESSON)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceId])
  @@index([sessionId, sortOrder])
}

model ScheduleLesson {
  id         String       @id @default(uuid()) @db.Uuid
  courseId   String       @db.Uuid
  sessionId  String?      @db.Uuid
  title      String       @db.VarChar(300)
  teacher    String       @db.VarChar(120)
  day        String       @db.VarChar(32)
  dateLabel  String       @db.VarChar(64)
  time       String       @db.VarChar(64)
  room       String       @db.VarChar(120)
  type       LessonType   @default(THEORY)
  duration   String       @db.VarChar(32)
  note       String?      @db.VarChar(500)
  status     LessonStatus @default(PLANNED)
  sortOrder  Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([courseId, sortOrder])
}

model Achievement {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  title       String @db.VarChar(200)
  description String @db.VarChar(500)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model PracticeTip {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  text      String @db.VarChar(500)
  sortOrder Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

model SessionProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  sessionId      String    @db.Uuid
  lastSlideIndex Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model Exam {
  id                 String     @id @default(uuid()) @db.Uuid
  title              String     @db.VarChar(200)
  description        String     @default("") @db.VarChar(2000)
  examFileKey        String     @default("") @db.VarChar(512)
  examOriginalName   String     @default("") @db.VarChar(255)
  examSize           Int        @default(0)
  answerFileKey      String     @default("") @db.VarChar(512)
  answerOriginalName String     @default("") @db.VarChar(255)
  answerSize         Int        @default(0)
  status             ExamStatus @default(DRAFT)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  submissions ExamSubmission[]
  grades      ExamGrade[]

  @@index([status, sortOrder])
}

model ExamSubmission {
  id           String   @id @default(uuid()) @db.Uuid
  examId       String   @db.Uuid
  userId       String   @db.Uuid
  fileKey      String   @db.VarChar(512)
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(64)
  size         Int
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([examId, submittedAt])
  @@index([userId])
}

/// Midterm / exam grade out of 100. Independent of whether a PDF was uploaded.
model ExamGrade {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @db.Uuid
  userId    String   @db.Uuid
  score     Decimal  @db.Decimal(4, 1)
  gradedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([userId])
}

model PracticeAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid
  courseId  String?  @db.Uuid
  sessionId String?  @db.Uuid
  term      Int      @default(1)
  category  String   @db.VarChar(32)
  title     String   @db.VarChar(200)
  source    String   @default("") @db.VarChar(200)
  note      String   @default("") @db.VarChar(1000)
  dueLabel  String   @default("کلاس بعد") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User                       @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course?                    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  session CourseSession?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  targets PracticeAssignmentTarget[]

  @@index([teacherId, createdAt])
  @@index([courseId])
  @@index([sessionId])
  @@index([courseId, term])
}

model PracticeAssignmentTarget {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  studentId    String @db.Uuid
  progress     Int    @default(0)
  score        Int    @default(0)
  teacherNote  String @default("") @db.VarChar(1000)

  assignment PracticeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model AttendanceRecord {
  id         String           @id @default(uuid()) @db.Uuid
  courseId   String           @db.Uuid
  studentId  String           @db.Uuid
  meetingKey String           @db.VarChar(80)
  term       Int              @default(1)
  status     AttendanceStatus
  markedById String           @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student  User   @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User   @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, meetingKey, term])
  @@index([courseId, meetingKey])
  @@index([studentId])
}

model TeacherNote {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid
  studentId String   @db.Uuid
  body      String   @default("") @db.VarChar(2000)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  teacher User @relation("TeacherNoteAuthor", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("TeacherNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

model StudentStarRating {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid
  studentId String   @db.Uuid
  stars     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User @relation("StudentStarTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentStarStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([studentId])
}

model PracticeLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  date      DateTime @db.Date
  minutes   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/// Durable copy of uploaded media. Disk under `uploads/` is only a cache and
/// is wiped on deploy; this table is what actually keeps files alive.
model StoredFile {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(512)
  mimeType  String   @db.VarChar(64)
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegistrationLeadStatus {
  CONSULTING
  DECIDING
  ENROLLED
  LOST
}

enum ReferralSource {
  INSTAGRAM
  GOOGLE
  STUDENT_REFERRAL
  FRIEND_FAMILY
  ADS
  WEBSITE
  INBOUND_CALL
  WALK_IN
  OTHER
}

enum CourseInterest {
  PIANO
  THEORY
  BOTH
  UNDECIDED
}

enum TimePreference {
  MORNING
  EVENING
  FLEXIBLE
}

enum AdminTaskKind {
  MANUAL
  ENROLLMENT
}

enum AdminTaskStatus {
  OPEN
  DONE
}

model RegistrationLead {
  id             String                 @id @default(uuid()) @db.Uuid
  contactDate    DateTime               @db.Date
  firstName      String                 @db.VarChar(40)
  lastName       String                 @db.VarChar(40)
  phone          String                 @db.VarChar(32)
  secondaryPhone String                 @default("") @db.VarChar(32)
  parentName     String                 @default("") @db.VarChar(80)
  age            String                 @default("") @db.VarChar(8)
  district       String                 @db.VarChar(16)
  referralSource ReferralSource         @default(INBOUND_CALL)
  status         RegistrationLeadStatus @default(CONSULTING)
  interest       CourseInterest         @default(PIANO)
  preferredDays  String[]               @default([])
  timePreference TimePreference         @default(FLEXIBLE)
  followUpDate   DateTime?              @db.Date
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  notes RegistrationLeadNote[]
  tasks AdminTask[]

  @@index([status])
  @@index([followUpDate])
  @@index([createdAt])
}

model RegistrationLeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  lead RegistrationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model AdminTask {
  id        String          @id @default(uuid()) @db.Uuid
  kind      AdminTaskKind   @default(MANUAL)
  status    AdminTaskStatus @default(OPEN)
  title     String          @db.VarChar(200)
  body      String          @default("") @db.VarChar(2000)
  dueDate   DateTime?       @db.Date
  phone     String?         @db.VarChar(32)
  leadId    String?         @db.Uuid
  createdAt DateTime        @default(now())
  doneAt    DateTime?

  lead RegistrationLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, kind])
  @@index([status, createdAt])
  @@index([kind, status])
}

enum SupportUnit {
  EDUCATION
  FINANCE
  RECEPTION
  TECH
}

enum SupportTicketStatus {
  PENDING
  REPLIED
  CLOSED
}

enum SupportMessageAuthor {
  STUDENT
  STAFF
}

model SupportTicket {
  id               String              @id @default(uuid()) @db.Uuid
  studentId        String              @db.Uuid
  unit             SupportUnit
  title            String              @db.VarChar(200)
  status           SupportTicketStatus @default(PENDING)
  unreadForStudent Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  student  User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([studentId, updatedAt])
  @@index([status, updatedAt])
  @@index([unit, status])
  @@index([unreadForStudent])
}

model SupportMessage {
  id        String                @id @default(uuid()) @db.Uuid
  ticketId  String                @db.Uuid
  author    SupportMessageAuthor
  body      String                @db.VarChar(4000)
  createdAt DateTime              @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
