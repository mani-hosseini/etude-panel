# Application
NODE_ENV=development
PORT=4000
APP_NAME=etude-panel-api
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://etude:etude@localhost:5432/etude_panel?schema=public

# JWT — generate strong secrets for production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated). Nest reflects the request Origin when it is in this list.
# If nginx also sets Access-Control-Allow-Origin, remove that and let Nest handle CORS.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://panel.etudepianoacademy.com

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Seed defaults (override in real deployments)
SEED_ADMIN_EMAIL=admin@etude.academy
SEED_ADMIN_PASSWORD=AdminEtude!2026
SEED_STUDENT_PASSWORD=etudepiano123
